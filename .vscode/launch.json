{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "? Run Feedstock.AI Application",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "? Run FastAPI with Live Reload (Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.app:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "?? Run Unit & Integration Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "backend/tests/test_api.py"
            ],
            "console": "integratedTerminal"
        }
    ]
}
